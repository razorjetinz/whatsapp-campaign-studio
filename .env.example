# Dashboard login. Change APP_PASSWORD before exposing the application.
APP_USERNAME=admin
APP_PASSWORD=replace-this-with-a-random-password-at-least-16-characters

# Meta WhatsApp Business Cloud API credentials (leave blank for dry-run mode).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v27.0

# Must match the verify token configured for the Meta webhook.
WEBHOOK_VERIFY_TOKEN=replace-this-with-a-long-random-webhook-token

# Safe by default: campaigns are simulated and no WhatsApp messages are sent.
# Set false only after configuring and verifying the Meta credentials.
DRY_RUN=true
SEND_DELAY_SECONDS=1.5
DATABASE_PATH=/data/campaign-studio.db
PORT=8080
